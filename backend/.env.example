# PayFilter Phase 2 Backend Configuration
# Copy this file to .env and populate with your Supabase project credentials

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Merchant-scoped test keys (used for RLS isolation verification)
SUPABASE_MERCHANT_A_KEY=your-merchant-a-key
SUPABASE_MERCHANT_B_KEY=your-merchant-b-key

# Model paths (relative to workspace root or absolute)
MODEL_PATH=ml/models/isolation_forest.pkl
MODEL_METADATA_PATH=ml/models/model_metadata.json

# Service config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
